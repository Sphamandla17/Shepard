<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_large">

        <!-- APP NAME -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/black"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- TAGLINE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/tagline"
            android:textColor="@color/grey_dark"
            android:textSize="16sp" />

        <!-- WELCOME TITLE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/welcome"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- DYNAMIC MEMBER NAME -->

        <TextView
            android:id="@+id/tvWelcomeMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/welcome_to_shepherd"
            android:textColor="@color/grey_dark"
            android:textSize="16sp" />

        <!-- PRAYER REQUESTS -->

        <Button
            android:id="@+id/btnPrayerRequests"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_button_primary"
            android:text="@string/prayer_requests"
            android:textAllCaps="false"
            android:textColor="@color/white" />

        <!-- EVENTS -->

        <Button
            android:id="@+id/btnEvents"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_medium"
            android:background="@drawable/bg_button_secondary"
            android:text="@string/events"
            android:textAllCaps="false"
            android:textColor="@color/black" />

        <!-- BIBLE -->

        <Button
            android:id="@+id/btnBible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_medium"
            android:background="@drawable/bg_button_secondary"
            android:text="@string/bible"
            android:textAllCaps="false"
            android:textColor="@color/black" />

        <!-- ANNOUNCEMENTS -->

        <Button
            android:id="@+id/btnAnnouncements"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_medium"
            android:background="@drawable/bg_button_secondary"
            android:text="@string/announcements"
            android:textAllCaps="false"
            android:textColor="@color/black" />

        <!-- NOTIFICATIONS -->

        <Button
            android:id="@+id/btnNotifications"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_medium"
            android:background="@drawable/bg_button_secondary"
            android:text="@string/notifications"
            android:textAllCaps="false"
            android:textColor="@color/black" />

        <!-- QR CHECK-IN -->

        <Button
            android:id="@+id/btnQrCheckIn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_medium"
            android:background="@drawable/bg_button_secondary"
            android:text="@string/qr_church_checkin"
            android:textAllCaps="false"
            android:textColor="@color/black" />

        <!-- PROFILE -->

        <Button
            android:id="@+id/btnProfile"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_medium"
            android:background="@drawable/bg_button_secondary"
            android:text="@string/my_profile"
            android:textAllCaps="false"
            android:textColor="@color/black" />

        <!-- SETTINGS -->

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_medium"
            android:background="@drawable/bg_button_secondary"
            android:text="@string/settings"
            android:textAllCaps="false"
            android:textColor="@color/black" />

    </LinearLayout>

</ScrollView>